# Supabase project credentials — copy this file to `.env.local` and fill in.
# Both values live under Project Settings → API in the Supabase dashboard.
#
# The anon key is a public key (safe to ship to the browser); server-side writes
# that bypass RLS must use the service_role key, which belongs on the backend.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
